# Defaults run without a model API key or Docker. Copy to .env only to override.
APP_ENV=development
LLM_MODE=demo
EMBEDDING_MODE=demo
# DATABASE_URL=postgresql+psycopg://atlas:YOUR_PASSWORD@127.0.0.1:5432/atlas
# JWT_SECRET=generate-at-least-32-random-characters
# QDRANT_URL=http://127.0.0.1:6333
# REDIS_URL=redis://127.0.0.1:6379/0

# Real Ollama models (install/pull separately, then set both modes to compatible):
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=
MODEL_TRUST_ENV=false
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=
# Demo uses 256; nomic-embed-text typically uses 768. Verify actual output first.
EMBEDDING_DIMENSION=256
# RERANK_MODEL=absolute-path-to-a-downloaded-cross-encoder
MCP_API_URL=http://127.0.0.1:8000
